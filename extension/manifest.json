{
  "manifest_version": 3,
  "name": "QuizMate · 智答伴侣",
  "version": "0.6.1",
  "description": "AI 练习与网课学习助手：支持本地 CLI/API、课程识别、正常播放与随堂练习预览填写，不自动提交。",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "nativeMessaging",
    "webNavigation",
    "offscreen"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 QuizMate 智答伴侣",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "commands": {
    "quizmate-toggle-task": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "开始、暂停或继续当前练习（使用已保存的配置）"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon-32.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "homepage_url": "https://github.com/SW1109/nexly-web-agent",
  "incognito": "not_allowed",
  "host_permissions": [
    "https://*.chaoxing.com/*",
    "https://*.zhihuishu.com/*",
    "https://www.icourse163.org/*",
    "https://moodle.syxy.ouchn.cn/*"
  ]
}
