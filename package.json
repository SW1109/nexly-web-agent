{
  "name": "quiz-mate",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "QuizMate 智答伴侣：Chrome / Edge AI 练习助手，支持本地 CLI 与 OpenAI 兼容 API",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "doctor": "node scripts/doctor.mjs",
    "setup:native": "node scripts/install-native.mjs",
    "uninstall:native": "node scripts/uninstall-native.mjs",
    "build:edge": "node scripts/build.mjs --edge",
    "pack:edge": "node scripts/package-edge.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SW1109/nexly-web-agent.git"
  },
  "bugs": {
    "url": "https://github.com/SW1109/nexly-web-agent/issues"
  },
  "homepage": "https://github.com/SW1109/nexly-web-agent#readme"
